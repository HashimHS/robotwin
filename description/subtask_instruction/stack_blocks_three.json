        "seen": [
            "Pick up {A} with {a}.",
            "Grasp {A} using {a}.",
            "Use {a} to pick up {A}.",
            "Take {A} with {a}.",
            "Grab {A} using {a}.",
            "With {a}, pick up {A}.",
            "Close {a} around {A} and lift it.",
            "Pick {A} off the table with {a}.",
            "Reach for {A} and grasp it with {a}.",
            "Lift {A} from the table using {a}."
        ],
        "unseen": [
            "Seize {A} with {a}.",
            "Get hold of {A} using {a}.",
            "Employ {a} to grasp {A}.",
            "Collect {A} with {a}.",
            "Hold {A} using {a}."
        ]
    },
