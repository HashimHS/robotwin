            "With {a}, stack {A} onto {B}.",
            "Lower {A} onto {B} using {a}.",
            "Release {A} onto {B} with {a}.",
            "Move {A} onto {B} with {a}.",
            "Pile {A} on {B} using {a}."
        ],
        "unseen": [
            "Deposit {A} on {B} with {a}.",
            "Rest {A} on {B} using {a}.",
            "Position {A} onto {B} with {a}.",
            "Settle {A} on {B} using {a}.",
            "Leave {A} on {B} with {a}."
        ]
    }
}
